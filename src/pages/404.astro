---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found | 10Best Living" description="The page you are looking for cannot be found.">

  <section class="min-h-[60vh] flex items-center justify-center px-6">
    <div class="text-center">
      <div class="text-8xl mb-6" data-aos="fade-down">🔍</div>
      <h1 class="font-serif text-7xl font-bold text-dark mb-4" data-aos="fade-up" data-aos-delay="100">404</h1>
      <p class="text-text-muted text-xl mb-4" data-i18n="page_not_found_title">此頁面已不見</p>
      <p class="text-text-muted text-base mb-10" data-i18n="page_not_found_desc">讓我們帶您回到首頁，那裡有更多精彩的評測等著您。</p>
      <a href="/" class="gold-btn inline-block px-8 py-3 rounded-lg font-semibold" data-aos="fade-up" data-aos-delay="200">
        <span data-i18n="btn_back_home">返回首頁</span>
      </a>
    </div>
  </section>
</BaseLayout>
