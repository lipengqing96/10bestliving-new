---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const postFiles = import.meta.glob('../../data/posts/*.json', { eager: true });
  return Object.keys(postFiles).map(p => ({ params: { slug: p.split('/').pop().replace('.json', '') } }));
}

const { slug } = Astro.params;
const postFiles = import.meta.glob('../../data/posts/*.json', { eager: true });
const posts = {};
for (const [p, mod] of Object.entries(postFiles)) {
  posts[p.split('/').pop().replace('.json', '')] = mod.default;
}
const post = posts[slug];
if (!post) Astro.redirect('/404');

const catZH = {
  Kitchen:'居家與廚房', 'Home & Kitchen':'居家與廚房',
  Fitness:'健身與健康', Health:'健身與健康', 'Fitness & Health':'健身與健康',
  'Smart Home':'智能家居',
  Beauty:'美容護理', 'Beauty Care':'美容護理',
  Travel:'戶外與旅行', 'Outdoor & Travel':'戶外與旅行',
  Sports:'運動用品', 'Sports Equipment':'運動用品',
  Cosmetics:'美容化妝品', 'Beauty & Cosmetics':'美容化妝品',
  Fashion:'織服鞋帽', 'Fashion & Footwear':'織服鞋帽', Clothing:'服裝鞋帽',
  Accessories:'衣服飾物', 'Clothing & Accessories':'衣服飾物',
  Bedroom:'臥室', 'Living Room':'客廳',
};
const catEN = {
  Kitchen:'Home & Kitchen', 'Home & Kitchen':'Home & Kitchen',
  Fitness:'Fitness & Health', Health:'Fitness & Health', 'Fitness & Health':'Fitness & Health',
  'Smart Home':'Smart Home',
  Beauty:'Beauty Care', 'Beauty Care':'Beauty Care',
  Travel:'Outdoor & Travel', 'Outdoor & Travel':'Outdoor & Travel',
  Sports:'Sports Equipment', 'Sports Equipment':'Sports Equipment',
  Cosmetics:'Beauty & Cosmetics', 'Beauty & Cosmetics':'Beauty & Cosmetics',
  Fashion:'Fashion & Footwear', 'Fashion & Footwear':'Fashion & Footwear', Clothing:'Fashion & Footwear',
  Accessories:'Clothing & Accessories', 'Clothing & Accessories':'Clothing & Accessories',
  Bedroom:'Bedroom', 'Living Room':'Living Room',
};
const categoryZh = catZH[post.category] || post.category;
const categoryEn = catEN[post.category] || post.category;
const titleZh = post.title_zh || post.title;
const contentZh = post.content_zh || post.content;
const description = post.description_zh || '專業評測與推薦';
---

<BaseLayout title={titleZh + ' | 10Best Living'} description={description} path={Astro.url.pathname}>
  <div class="bg-white text-dark min-h-screen pt-24 pb-16">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <a href="/blog" class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-gold transition-colors mb-8">&#8592; Back to Reviews</a>
      
      {post.featuredImg && (
        <div class="w-full aspect-[16/9] rounded-2xl overflow-hidden mb-8">
          <img src={post.featuredImg} alt={titleZh} class="w-full h-full object-cover" loading="lazy" />
        </div>
      )}
      
      <div class="flex flex-wrap items-center gap-4 mb-6">
        <span class="px-3 py-1 bg-cream rounded-full text-xs font-medium text-primary" data-lang-content="zh-TW">{categoryZh}</span>
        <span class="px-3 py-1 bg-cream rounded-full text-xs font-medium text-primary" data-lang-content="en">{categoryEn}</span>
        <span class="text-sm text-text-muted">{post.date}</span>
        <span class="text-sm text-text-muted">{post.readTime} read</span>
      </div>
      
      <h1 class="font-serif text-4xl lg:text-5xl font-bold text-primary mb-8 leading-tight" data-lang-content="zh-TW">{titleZh}</h1>
      <h1 class="font-serif text-4xl lg:text-5xl font-bold text-primary mb-8 leading-tight hidden" data-lang-content="en">{post.title}</h1>
      
      <!-- Chinese content -->
      <div class="prose prose-lg max-w-none prose-headings:font-serif prose-headings:text-primary prose-p:text-dark prose-p:leading-relaxed prose-li:ml-4" data-lang-content="zh-TW">
        {(() => {
          const NL = String.fromCharCode(10);
          const lines = contentZh.split(NL);
          return lines.map((line, i) => {
            if (line.startsWith('# ')) return <h1 key={i} class="font-serif text-2xl lg:text-3xl font-bold text-primary my-8">{line.slice(2)}</h1>;
            if (line.startsWith('## ')) return <h2 key={i} class="font-serif text-xl lg:text-2xl font-semibold text-primary my-6">{line.slice(3)}</h2>;
            if (line.startsWith('### ')) return <h3 key={i} class="text-lg font-semibold text-primary my-4">{line.slice(4)}</h3>;
            if (line.startsWith('| ') && line.includes('|--')) return null;
            if (line.startsWith('| ')) {
              const cells = line.split('|').filter(Boolean).map(c => c.trim());
              return <div key={i} class="grid gap-2 py-2 border-b border-border text-sm" style={{gridTemplateColumns: `repeat(${cells.length}, 1fr)`}}>{cells.map((cell, j) => <div key={j} class="px-2">{cell}</div>)}</div>;
            }
            if (line.startsWith('- ')) return <li key={i} class="ml-4 list-disc">{line.slice(2)}</li>;
            if (line.trim() === '') return <br key={i} />;
            return <p key={i} class="my-3 leading-relaxed">{line}</p>;
          });
        })()}
      </div>
      
      <!-- English content -->
      <div class="prose prose-lg max-w-none prose-headings:font-serif prose-headings:text-primary prose-p:text-dark prose-p:leading-relaxed prose-li:ml-4" data-lang-content="en" style="display:none">
        {(() => {
          const NL = String.fromCharCode(10);
          const lines = post.content.split(NL);
          return lines.map((line, i) => {
            if (line.startsWith('# ')) return <h1 key={i} class="font-serif text-2xl lg:text-3xl font-bold text-primary my-8">{line.slice(2)}</h1>;
            if (line.startsWith('## ')) return <h2 key={i} class="font-serif text-xl lg:text-2xl font-semibold text-primary my-6">{line.slice(3)}</h2>;
            if (line.startsWith('### ')) return <h3 key={i} class="text-lg font-semibold text-primary my-4">{line.slice(4)}</h3>;
            if (line.startsWith('| ') && line.includes('|--')) return null;
            if (line.startsWith('| ')) {
              const cells = line.split('|').filter(Boolean).map(c => c.trim());
              return <div key={i} class="grid gap-2 py-2 border-b border-border text-sm" style={{gridTemplateColumns: `repeat(${cells.length}, 1fr)`}}>{cells.map((cell, j) => <div key={j} class="px-2">{cell}</div>)}</div>;
            }
            if (line.startsWith('- ')) return <li key={i} class="ml-4 list-disc">{line.slice(2)}</li>;
            if (line.trim() === '') return <br key={i} />;
            return <p key={i} class="my-3 leading-relaxed">{line}</p>;
          });
        })()}
      </div>
      
      <div class="mt-12 pt-8 border-t border-border flex items-center justify-between">
        <span class="text-sm text-text-muted" data-i18n="share">Share this review:</span>
        <button id="backToTop" class="gold-btn px-4 py-2 text-sm hidden" aria-label="Back to top">&#8593; Back to top</button>
      </div>
    </div>
  </div>
</BaseLayout>
