---
import Header from '../components/Header.astro';
import '../styles/global.css';
---

<footer class="bg-dark text-white">
  <div class="border-b border-gold/30"></div>
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <div class="flex flex-col items-start mb-5">
          <span class="font-serif text-2xl font-bold tracking-tight">
            <span class="text-gold">10</span>Best
          </span>
          <span class="text-xs font-sans font-light tracking-[0.25em] uppercase text-text-silent mt-0.5">Living</span>
        </div>
        <p class="text-sm text-gray-400 leading-relaxed mb-6">
          <span data-i18n="footer_desc">為講究品味的生活精選頂級產品評測。專業洞察、公正評分、永恆之選。</span>
        </p>
        <div class="flex gap-4">
          <a href="#" class="w-9 h-9 rounded-full border border-gray-600 flex items-center justify-center text-gray-400 hover:text-gold hover:border-gold transition-all duration-200" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="#" class="w-9 h-9 rounded-full border border-gray-600 flex items-center justify-center text-gray-400 hover:text-gold hover:border-gold transition-all duration-200" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
          <a href="#" class="w-9 h-9 rounded-full border border-gray-600 flex items-center justify-center text-gray-400 hover:text-gold hover:border-gold transition-all duration-200" aria-label="Twitter">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
          </a>
          <a href="#" class="w-9 h-9 rounded-full border border-gray-600 flex items-center justify-center text-gray-400 hover:text-gold hover:border-gold transition-all duration-200" aria-label="Pinterest">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 12a4 4 0 1 1 8 0c0 4-3 6-3 10"/><path d="M9.5 17.5 8 22"/><path d="M12 8c-1.5-2-4-3-6-3-2.5 0-4 2-4 5 0 4 3 6 3 10"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-sm font-sans font-semibold uppercase tracking-widest text-gold mb-5" data-i18n="footer_quick_links">快速連結</h4>
        <ul class="space-y-3">
          <li><a href="/" class="text-sm text-gray-400 hover:text-gold transition-colors duration-200" data-i18n="footer_home">首頁</a></li>
          <li><a href="/blog" class="text-sm text-gray-400 hover:text-gold transition-colors duration-200" data-i18n="footer_recent_posts">最新文章</a></li>
                    <li><a href="/about" class="text-sm text-gray-400 hover:text-gold transition-colors duration-200" data-i18n="footer_about">關於我們</a></li>
          <li><a href="/contact" class="text-sm text-gray-400 hover:text-gold transition-colors duration-200" data-i18n="footer_contact">聯絡我們</a></li>
        </ul>
      </div>

      <!-- Categories -->
      <div>
        <h4 class="text-sm font-sans font-semibold uppercase tracking-widest text-gold mb-5" data-i18n="footer_all_categories">商品分類</h4>
        <ul class="space-y-3">
          <li><a href="/blog?category=home-kitchen" class="text-sm text-gray-400 hover:text-gold transition-colors duration-200" data-i18n="category_home_kitchen">居家與廚房</a></li>
          <li><a href="/blog?category=fitness-health" class="text-sm text-gray-400 hover:text-gold transition-colors duration-200" data-i18n="category_fitness_health">健身與健康</a></li>
          <li><a href="/blog?category=smart-home" class="text-sm text-gray-400 hover:text-gold transition-colors duration-200" data-i18n="category_smart_home">智能家居</a></li>
          <li><a href="/blog?category=beauty" class="text-sm text-gray-400 hover:text-gold transition-colors duration-200" data-i18n="category_beauty">美容護理</a></li>
          <li><a href="/blog?category=outdoor" class="text-sm text-gray-400 hover:text-gold transition-colors duration-200" data-i18n="category_outdoor">戶外與旅行</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="text-sm font-sans font-semibold uppercase tracking-widest text-gold mb-5" data-i18n="footer_legal_info">法律資訊</h4>
        <ul class="space-y-3">
          <li><a href="/privacy-policy" class="text-sm text-gray-400 hover:text-gold transition-colors duration-200" data-i18n="cookie_policy_link">隱私權政策</a></li>
          <li><a href="/terms-of-service" class="text-sm text-gray-400 hover:text-gold transition-colors duration-200" data-i18n="footer_terms">服務條款</a></li>
          <li><a href="/affiliate-disclosure" class="text-sm text-gray-400 hover:text-gold transition-colors duration-200" data-i18n="footer_affiliate">聯盟披露</a></li>
        </ul>
        <p class="text-xs text-gray-500 mt-6 leading-relaxed">
          <span data-i18n="affiliate_note">作為Amazon聯盟會員，我們從符合資格的購買中獲得佣金。所有推薦均獨立且公正。</span>
        </p>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-gray-500"><span data-i18n="footer_copyright">&copy; 2026 PickProDeals. 版權所有。</span></p>
      <div class="flex gap-6">
        <a href="/privacy-policy" class="text-xs text-gray-500 hover:text-gold transition-colors" data-i18n="cookie_policy_link">隱私權政策</a>
        <a href="/terms-of-service" class="text-xs text-gray-500 hover:text-gold transition-colors" data-i18n="footer_terms">服務條款</a>
        <a href="/affiliate-disclosure" class="text-xs text-gray-400 hover:text-gold transition-colors" data-i18n="footer_affiliate">聯盟披露</a>
      </div>
    </div>
  </div>
</footer>