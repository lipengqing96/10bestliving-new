---

<div class="lang-switcher flex items-center gap-1 ml-2 pl-2" style="border-left:1px solid #E8E4DD;padding-left:0.75rem;margin-left:0.25rem">
  <button
    data-lang-btn
    data-lang="zh-TW"
    class="lang-btn px-2 py-1 rounded text-xs font-medium transition-all duration-200 bg-gold text-dark"
    aria-label="繁體中文"
  >繁</button>
  <span class="text-text-silent text-xs">/</span>
  <button
    data-lang-btn
    data-lang="en"
    class="lang-btn px-2 py-1 rounded text-xs font-medium transition-all duration-200 text-text-muted hover:text-primary"
    aria-label="Switch to English"
  >EN</button>
</div>
