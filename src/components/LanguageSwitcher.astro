---
// Language Switcher Component
const { currentLang } = Astro.props;
---

<div class="lang-switcher flex items-center gap-1">
  <button
    data-lang-btn
    data-lang="zh-TW"
    class="lang-btn px-2 py-1 rounded text-xs font-medium transition-all duration-200 "
    aria-label="切換為繁體中文"
  >
    繁
  </button>
  <span class="text-text-silent text-xs">/</span>
  <button
    data-lang-btn
    data-lang="en"
    class="lang-btn px-2 py-1 rounded text-xs font-medium transition-all duration-200 "
    aria-label="Switch to English"
  >
    EN
  </button>
</div>

<style>
  .lang-switcher {
    border-left: 1px solid var(--color-border, #E8E4DD);
    padding-left: 0.75rem;
    margin-left: 0.25rem;
  }
  .lang-btn:hover {
    background-color: rgba(201, 169, 98, 0.15);
  }
</style>
